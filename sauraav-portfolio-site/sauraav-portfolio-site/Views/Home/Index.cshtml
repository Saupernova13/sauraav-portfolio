@using sauraav_portfolio_site.Helpers
@model sauraav_portfolio_site.Models.PortfolioViewModel
@{
  Layout = null;
  var sectionIndex = 1;
  string Next() => $"section{++sectionIndex}";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Portfolio of Sauraav Jayrajh: software developer, designer and problem solver.">
  <meta name="theme-color" content="#121212">
  <title>Sauraav Jayrajh - Portfolio</title>
  <link rel="icon" type="image/x-icon" href="~/favicon.ico">
  <link rel="preload" href="~/fonts/Gendy.otf" as="font" type="font/otf" crossorigin>
  <link rel="stylesheet" href="~/css/portfolio.css" asp-append-version="true" />
</head>
<body>
  <svg hidden aria-hidden="true" focusable="false">
    <symbol id="icon-chevron" viewBox="0 0 24 24"><path fill="currentColor" d="M12 15.5 4.5 8l1.4-1.4L12 12.7l6.1-6.1L19.5 8z"/></symbol>
    <symbol id="icon-pin" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></symbol>
  </svg>

  <canvas id="starfield" class="starfield" aria-hidden="true"></canvas>

  <!-- Section 1: Introduction -->
  <section id="section1" class="hero-section">
    <div class="main-container cyber-button">
      <div class="text-content">
        <h1 class="welcome-message">Welcome! Greetings!</h1>
        <p class="name-text">My name is Sauraav Jayrajh.</p>
        <p class="typing-container">I'm <span class="typing-text" aria-live="off"></span></p>
      </div>
      <div class="profile-container">
        <div class="parallax-wrapper">
          <picture>
            <source srcset="~/images/PFP_No_Me.webp" type="image/webp">
            <img src="~/images/PFP_No_Me.png" alt="" class="profile-pic background-img" width="720" height="720" decoding="async">
          </picture>
          <picture>
            <source srcset="~/images/PFP_With_Me.webp" type="image/webp">
            <img src="~/images/PFP_With_Me.png" alt="Portrait of Sauraav Jayrajh" class="profile-pic foreground-img" width="720" height="720" fetchpriority="high" decoding="async">
          </picture>
        </div>
        <nav class="social-icons-mobile" aria-label="Social links">
          <a href="https://github.com/Saupernova13" class="social-icon-mobile" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <img src="~/images/github.webp" alt="" width="240" height="240" loading="lazy" decoding="async">
          </a>
          <a href="https://www.linkedin.com/in/sauraavjayrajh/" class="social-icon-mobile" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <img src="~/images/linkedin.webp" alt="" width="240" height="240" loading="lazy" decoding="async">
          </a>
          <a href="mailto:sauraavjayrajh@gmail.com" class="social-icon-mobile" aria-label="Email">
            <img src="~/images/email.webp" alt="" width="240" height="240" loading="lazy" decoding="async">
          </a>
          <a href="https://stardustsoftware.carrd.co/" class="social-icon-mobile" target="_blank" rel="noopener noreferrer" aria-label="Stardust Software">
            <img src="~/images/stardust.webp" alt="" width="240" height="240" loading="lazy" decoding="async">
          </a>
          <a href="https://drive.google.com/file/d/1duN5lgNshz1Bo1516R6vCmaBTVu5IonO/view?usp=sharing" class="social-icon-mobile" target="_blank" rel="noopener noreferrer" aria-label="CV">
            <img src="~/images/cv.webp" alt="" width="240" height="232" loading="lazy" decoding="async">
          </a>
        </nav>
      </div>
    </div>
    <button class="scroll-button cyber-button" type="button" data-scroll-to="@Next()" aria-label="Scroll to About Me">
      <svg class="icon" aria-hidden="true"><use href="#icon-chevron"/></svg>
    </button>
  </section>

  <!-- Section 2: Summary -->
  <section id="section2" class="portfolio-section">
    <div class="section-content">
      <h2 class="section-title reveal">About Me</h2>
      <div class="summary-container">
        @if (!string.IsNullOrEmpty(Model.Summary?.Summary))
        {
          <div class="summary-content card-lit reveal">
            <div class="summary-text">
              @foreach (var paragraph in Model.Summary.Summary.Split('\n', StringSplitOptions.RemoveEmptyEntries))
              {
                <p>@paragraph</p>
              }
            </div>
            <div class="summary-decoration" aria-hidden="true"><div class="code-lines"></div></div>
          </div>
        }
      </div>
    </div>
    <button class="scroll-button cyber-button" type="button" data-scroll-to="@Next()" aria-label="Scroll to Education">
      <svg class="icon" aria-hidden="true"><use href="#icon-chevron"/></svg>
    </button>
  </section>

  <!-- Section 3: Education -->
  <section id="section3" class="portfolio-section cv-auto">
    <div class="section-content">
      <h2 class="section-title reveal">Education</h2>
      <div class="education-grid">
        @if (Model.Education is not null)
        {
          foreach (var edu in Model.Education.Values.OrderByDescending(e => e.EndDate))
          {
            <article class="education-card reveal">
              <div class="education-content card-lit">
                <div class="education-header">
                  <h3 class="institution-name">@edu.SchoolName</h3>
                  <span class="education-period">@ViewHelpers.FormatDateRange(edu.StartDate, edu.EndDate)</span>
                </div>
                <div class="education-details">
                  @if (!string.IsNullOrWhiteSpace(edu.Location))
                  {
                    <span class="education-location">
                      <svg class="icon" aria-hidden="true"><use href="#icon-pin"/></svg> @edu.Location
                    </span>
                  }
                  <p class="education-description">@edu.Description</p>
                </div>
              </div>
            </article>
          }
        }
      </div>
    </div>
    <button class="scroll-button cyber-button" type="button" data-scroll-to="@Next()" aria-label="Scroll to Experience">
      <svg class="icon" aria-hidden="true"><use href="#icon-chevron"/></svg>
    </button>
  </section>

  <!-- Section 4: Experience -->
  <section id="section4" class="portfolio-section cv-auto">
    <div class="section-content">
      <h2 class="section-title reveal">Experience</h2>
      <div class="experience-timeline">
        @if (Model.Experience is not null)
        {
          foreach (var exp in Model.Experience.Values.OrderByDescending(e => e.EndDate))
          {
            <article class="experience-item reveal">
              <div class="experience-marker" aria-hidden="true">
                <div class="marker-dot"></div>
                <div class="marker-line"></div>
              </div>
              <div class="experience-content card-lit">
                <div class="experience-header">
                  <h3 class="experience-title">@exp.Title</h3>
                  <span class="experience-date">@ViewHelpers.FormatDateRange(exp.StartDate, exp.EndDate)</span>
                </div>
                <span class="experience-location">@exp.Location</span>
                @if (exp.Accomplishments.Count > 0)
                {
                  <div class="experience-details">
                    <ul class="accomplishments-list">
                      @foreach (var item in exp.Accomplishments)
                      {
                        <li>@item</li>
                      }
                    </ul>
                  </div>
                }
              </div>
            </article>
          }
        }
      </div>
    </div>
    <button class="scroll-button cyber-button" type="button" data-scroll-to="@Next()" aria-label="Scroll to Projects">
      <svg class="icon" aria-hidden="true"><use href="#icon-chevron"/></svg>
    </button>
  </section>

  <!-- Section 5: Projects -->
  <section id="section5" class="portfolio-section cv-auto">
    <div class="section-content">
      <h2 class="section-title reveal">Projects</h2>
      <div class="projects-container">
        <div class="project-preview">
          <div class="preview-content">
            <img class="project-media project-image" alt="" hidden decoding="async">
            <video class="project-media project-video" muted loop playsinline preload="none" hidden></video>
            <div class="project-overlay">
              <p class="project-description"></p>
            </div>
          </div>
        </div>
        <div class="projects-list" role="list">
          @if (Model.Projects is not null)
          {
            foreach (var project in Model.Projects.Values)
            {
              <div class="project-item" role="listitem" tabindex="0"
                   data-media="@project.DemoVideoPath"
                   data-description="@project.Description">
                <div class="project-name">@project.ProjectName</div>
                @if (!string.IsNullOrWhiteSpace(project.ProjectLink))
                {
                  <a href="@project.ProjectLink" class="visit-button" target="_blank" rel="noopener noreferrer">
                    Visit Project
                  </a>
                }
              </div>
            }
          }
        </div>
      </div>
    </div>
    <button class="scroll-button cyber-button" type="button" data-scroll-to="@Next()" aria-label="Scroll to Qualifications">
      <svg class="icon" aria-hidden="true"><use href="#icon-chevron"/></svg>
    </button>
  </section>

  <!-- Section 6: Qualifications -->
  <section id="section6" class="portfolio-section cv-auto">
    <div class="section-content">
      <h2 class="section-title reveal">Qualifications</h2>
      <div class="qualifications-grid">
        @if (Model.Qualifications is not null)
        {
          foreach (var (key, qual) in Model.Qualifications)
          {
            <article class="qualification-card reveal">
              <div class="qualification-content card-lit">
                @if (!string.IsNullOrEmpty(qual.ImageBase64))
                {
                  <div class="image-container">
                    <img src="@Url.Action("Image", "Media", new { section = sauraav_portfolio_site.Models.PortfolioSections.Qualifications, key })"
                         alt="@qual.QualificationName certificate"
                         class="qualification-image" width="250" height="250" loading="lazy" decoding="async" />
                  </div>
                }
                <h3 class="qualification-name">@qual.QualificationName</h3>
              </div>
            </article>
          }
        }
      </div>
    </div>
    <button class="scroll-button cyber-button" type="button" data-scroll-to="@Next()" aria-label="Scroll to Skills">
      <svg class="icon" aria-hidden="true"><use href="#icon-chevron"/></svg>
    </button>
  </section>

  <!-- Section 7: Skills -->
  <section id="section7" class="portfolio-section cv-auto">
    <div class="section-content">
      <h2 class="section-title reveal">Skills</h2>
      <div class="skills-container">
        @if (Model.Skills is not null)
        {
          foreach (var skill in Model.Skills.Values.OrderByDescending(s => s.SkillLevel))
          {
            <article class="skill-card reveal">
              <div class="skill-content card-lit">
                <div class="skill-info">
                  <h3 class="skill-name">@skill.SkillName</h3>
                  <div class="skill-level-container">
                    <div class="skill-bar" role="meter" aria-valuemin="0" aria-valuemax="10" aria-valuenow="@skill.SkillLevel" aria-label="@skill.SkillName level">
                      <div class="skill-progress" data-level="@skill.SkillLevel"></div>
                    </div>
                    <span class="skill-level-text">@skill.SkillLevel/10</span>
                  </div>
                </div>
              </div>
            </article>
          }
        }
      </div>
    </div>
    <button class="scroll-button cyber-button" type="button" data-scroll-to="@Next()" aria-label="Scroll to Tech Stack">
      <svg class="icon" aria-hidden="true"><use href="#icon-chevron"/></svg>
    </button>
  </section>

  <!-- Section 8: Tech Stack -->
  <section id="section8" class="portfolio-section cv-auto">
    <div class="section-content">
      <h2 class="section-title reveal">Tech Stack</h2>
      <div class="tech-stack-container">
        @foreach (var (file, label) in new[]
        {
          ("csharp", "C#"), ("java", "Java"), ("javascript", "JavaScript"), ("kotlin", "Kotlin"), ("delphi", "Delphi"),
          ("html", "HTML"), ("css", "CSS"), ("dotnet", ".NET"), ("mssqlserver", "SQL Server"), ("mysql", "MySQL"),
          ("mongodb", "MongoDB"), ("firebase", "Firebase"), ("github", "GitHub"), ("azure", "Azure"), ("linux", "Linux"),
          ("unity", "Unity"), ("godot", "Godot"), ("chatgpt", "ChatGPT"), ("claude", "Claude"), ("llama", "LLaMA"),
          ("latex", "LaTeX"), ("blender", "Blender"), ("photoshop", "Photoshop"),
        })
        {
          <div class="tech-icon-wrapper reveal" data-tech="@label">
            <img src="~/images/@(file).webp" alt="@label" class="tech-icon" width="120" height="120" loading="lazy" decoding="async" />
          </div>
        }
      </div>
    </div>
  </section>

  <script src="~/js/portfolio/starfield.js" asp-append-version="true" defer></script>
  <script src="~/js/portfolio/effects.js" asp-append-version="true" defer></script>
  <script src="~/js/portfolio/sections.js" asp-append-version="true" defer></script>
</body>
</html>
