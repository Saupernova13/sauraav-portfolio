@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
  ViewData["Title"] = "Admin";
}

@section Styles {
  <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<meta name="__RequestVerificationToken" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken">

<div class="admin-shell">
  <aside class="admin-sidebar">
    <p class="admin-brand">sauraav<span>/admin</span></p>
    <nav class="admin-nav" aria-label="Content sections">
      <button type="button" class="admin-nav-item is-active" data-panel="summary">Summary</button>
      <button type="button" class="admin-nav-item" data-panel="education">Education</button>
      <button type="button" class="admin-nav-item" data-panel="experience">Experience</button>
      <button type="button" class="admin-nav-item" data-panel="projects">Projects</button>
      <button type="button" class="admin-nav-item" data-panel="qualifications">Qualifications</button>
      <button type="button" class="admin-nav-item" data-panel="skills">Skills</button>
    </nav>
    <div class="admin-sidebar-foot">
      <a href="/" class="admin-link">View site</a>
      <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="btn btn-ghost">Log out</button>
      </form>
    </div>
  </aside>

  <main class="admin-main">

    <!-- Summary -->
    <section class="admin-panel is-active" id="panel-summary">
      <header class="panel-head">
        <h1>Summary</h1>
        <p>The “About Me” paragraph on the home page. Blank lines split paragraphs.</p>
      </header>
      <form id="summaryForm" class="panel-card" data-section="summary">
        <label class="field">
          <span class="field-label">Summary text</span>
          <textarea name="summary" rows="8" required></textarea>
        </label>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save summary</button>
        </div>
      </form>
    </section>

    <!-- Education -->
    <section class="admin-panel" id="panel-education">
      <header class="panel-head">
        <h1>Education</h1>
        <p>Entries are keyed by school name; saving an existing name overwrites it.</p>
      </header>
      <form id="educationForm" class="panel-card" data-section="education">
        <div class="field-grid">
          <label class="field">
            <span class="field-label">School name</span>
            <input type="text" name="schoolName" data-key required>
          </label>
          <label class="field">
            <span class="field-label">Location</span>
            <input type="text" name="location">
          </label>
        </div>
        <label class="field">
          <span class="field-label">Description</span>
          <textarea name="description" rows="3"></textarea>
        </label>
        <div class="field-grid">
          <div class="field">
            <label class="field-toggle">
              <input type="checkbox" data-toggles="eduStartDate"> <span>Start date</span>
            </label>
            <input type="date" name="startDate" id="eduStartDate" disabled>
          </div>
          <div class="field">
            <label class="field-toggle">
              <input type="checkbox" data-toggles="eduEndDate"> <span>End date</span>
            </label>
            <input type="date" name="endDate" id="eduEndDate" disabled>
          </div>
        </div>
        <div class="field">
          <span class="field-label">Image</span>
          <input type="file" data-image="imageBase64" accept="image/*">
          <img class="image-preview" data-preview alt="" hidden>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save entry</button>
          <button type="reset" class="btn btn-ghost">Clear</button>
        </div>
      </form>
      <div class="panel-card">
        <h2 class="card-title">Existing entries</h2>
        <table class="data-table" data-table="education">
          <thead><tr><th>School</th><th>Location</th><th>Duration</th><th class="col-actions"></th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </section>

    <!-- Experience -->
    <section class="admin-panel" id="panel-experience">
      <header class="panel-head">
        <h1>Experience</h1>
        <p>Entries are keyed by title; saving an existing title overwrites it.</p>
      </header>
      <form id="experienceForm" class="panel-card" data-section="experience">
        <div class="field-grid">
          <label class="field">
            <span class="field-label">Title</span>
            <input type="text" name="title" data-key required>
          </label>
          <label class="field">
            <span class="field-label">Location</span>
            <input type="text" name="location">
          </label>
        </div>
        <div class="field">
          <span class="field-label">Accomplishments</span>
          <div data-list="accomplishments" class="repeat-list"></div>
          <button type="button" class="btn btn-ghost btn-sm" data-list-add="accomplishments">Add line</button>
        </div>
        <div class="field-grid">
          <div class="field">
            <label class="field-toggle">
              <input type="checkbox" data-toggles="expStartDate"> <span>Start date</span>
            </label>
            <input type="date" name="startDate" id="expStartDate" disabled>
          </div>
          <div class="field">
            <label class="field-toggle">
              <input type="checkbox" data-toggles="expEndDate"> <span>End date</span>
            </label>
            <input type="date" name="endDate" id="expEndDate" disabled>
          </div>
        </div>
        <div class="field">
          <span class="field-label">Image</span>
          <input type="file" data-image="imageBase64" accept="image/*">
          <img class="image-preview" data-preview alt="" hidden>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save entry</button>
          <button type="reset" class="btn btn-ghost">Clear</button>
        </div>
      </form>
      <div class="panel-card">
        <h2 class="card-title">Existing entries</h2>
        <table class="data-table" data-table="experience">
          <thead><tr><th>Title</th><th>Location</th><th>Duration</th><th class="col-actions"></th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </section>

    <!-- Projects -->
    <section class="admin-panel" id="panel-projects">
      <header class="panel-head">
        <h1>Projects</h1>
        <p>Demo videos accept .mp4, .webm or .gif up to 100 MB.</p>
      </header>
      <form id="projectForm" class="panel-card" data-section="projects">
        <div class="field-grid">
          <label class="field">
            <span class="field-label">Project name</span>
            <input type="text" name="projectName" data-key required>
          </label>
          <label class="field">
            <span class="field-label">Project link</span>
            <input type="url" name="projectLink">
          </label>
        </div>
        <label class="field">
          <span class="field-label">Description</span>
          <textarea name="description" rows="3"></textarea>
        </label>
        <div class="field">
          <span class="field-label">Demo video</span>
          <input type="file" data-video accept="video/mp4,video/webm,image/gif">
          <video class="image-preview" data-preview controls hidden></video>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save entry</button>
          <button type="reset" class="btn btn-ghost">Clear</button>
        </div>
      </form>
      <div class="panel-card">
        <h2 class="card-title">Existing entries</h2>
        <table class="data-table" data-table="projects">
          <thead><tr><th>Name</th><th>Link</th><th>Demo</th><th class="col-actions"></th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </section>

    <!-- Qualifications -->
    <section class="admin-panel" id="panel-qualifications">
      <header class="panel-head">
        <h1>Qualifications</h1>
        <p>Certificates and awards shown in the qualifications grid.</p>
      </header>
      <form id="qualificationForm" class="panel-card" data-section="qualifications">
        <label class="field">
          <span class="field-label">Qualification name</span>
          <input type="text" name="qualificationName" data-key required>
        </label>
        <div class="field">
          <span class="field-label">Image</span>
          <input type="file" data-image="imageBase64" accept="image/*">
          <img class="image-preview" data-preview alt="" hidden>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save entry</button>
          <button type="reset" class="btn btn-ghost">Clear</button>
        </div>
      </form>
      <div class="panel-card">
        <h2 class="card-title">Existing entries</h2>
        <table class="data-table" data-table="qualifications">
          <thead><tr><th>Qualification</th><th class="col-actions"></th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </section>

    <!-- Skills -->
    <section class="admin-panel" id="panel-skills">
      <header class="panel-head">
        <h1>Skills</h1>
        <p>Skill level is shown as a 1–10 bar on the home page.</p>
      </header>
      <form id="skillForm" class="panel-card" data-section="skills">
        <div class="field-grid">
          <label class="field">
            <span class="field-label">Skill name</span>
            <input type="text" name="skillName" data-key required>
          </label>
          <label class="field">
            <span class="field-label">Level: <output data-range-output>5</output>/10</span>
            <input type="range" name="skillLevel" min="1" max="10" value="5" data-range>
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save entry</button>
          <button type="reset" class="btn btn-ghost">Clear</button>
        </div>
      </form>
      <div class="panel-card">
        <h2 class="card-title">Existing entries</h2>
        <table class="data-table" data-table="skills">
          <thead><tr><th>Skill</th><th>Level</th><th class="col-actions"></th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </section>

  </main>
</div>

<dialog id="confirmDialog" class="admin-dialog">
  <p id="confirmMessage">Delete this entry?</p>
  <div class="form-actions">
    <button type="button" class="btn btn-danger" id="confirmYes">Delete</button>
    <button type="button" class="btn btn-ghost" id="confirmNo">Cancel</button>
  </div>
</dialog>

<div id="statusToast" class="admin-toast" role="status" aria-live="polite" hidden></div>

@section Scripts {
  <script src="~/js/admin/admin.js" asp-append-version="true"></script>
}
