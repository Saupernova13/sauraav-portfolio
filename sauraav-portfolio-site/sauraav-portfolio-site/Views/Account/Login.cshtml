@model sauraav_portfolio_site.Models.LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}

@section Styles {
  <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="login-wrap">
  <div class="login-card">
    <p class="admin-brand">sauraav<span>/admin</span></p>

    <form asp-action="Login" method="post">
      <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
      <div asp-validation-summary="ModelOnly" class="login-error"></div>

      <label class="field">
        <span class="field-label">Username</span>
        <input asp-for="Username" type="text" autocomplete="username" autofocus />
      </label>

      <label class="field">
        <span class="field-label">Password</span>
        <input asp-for="Password" type="password" autocomplete="current-password" />
      </label>

      <button type="submit" class="btn btn-primary">Log in</button>
    </form>
  </div>
</div>
