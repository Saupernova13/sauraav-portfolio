@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

@section Styles {
  <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="login-wrap">
  <div class="login-card">
    <p class="admin-brand">sauraav<span>/error</span></p>
    <p>Something went wrong while processing your request.</p>
    @if (Model.ShowRequestId)
    {
      <p class="login-error">Request ID: <code>@Model.RequestId</code></p>
    }
    <a href="/" class="btn btn-primary admin-link" style="display:inline-block;margin-top:1rem;text-align:center;color:#fff">Back to site</a>
  </div>
</div>
