@model ErrorViewModel
@{
  ViewData["Title"] = "Error";
}

<div class="container py-5">
  <div class="card admin-card login-card mx-auto">
    <div class="card-body p-4 p-md-5">
      <h1 class="h3 text-danger">Something went wrong.</h1>
      <p class="text-secondary">The page could not be shown right now. Please try again in a moment.</p>
      @if (Model.ShowRequestId)
      {
        <p class="mb-0 small text-secondary">Request ID <code>@Model.RequestId</code></p>
      }
      <a class="btn btn-outline-light mt-4" asp-controller="Home" asp-action="Index">Back to the portfolio</a>
    </div>
  </div>
</div>
