<!DOCTYPE html>
<html lang="en" class="admin-html">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#121212">
  <title>@ViewData["Title"] - Sauraav Jayrajh</title>
  <link rel="icon" type="image/x-icon" href="~/favicon.ico">
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
  <header class="admin-topbar">
    <nav class="container-fluid d-flex align-items-center justify-content-between gap-3 py-2">
      <a class="admin-brand" asp-controller="Home" asp-action="Index">
        <span class="admin-brand-dot" aria-hidden="true"></span>
        Sauraav Jayrajh
      </a>
      <div class="d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-outline-light" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">View site</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            <button type="submit" class="btn btn-sm btn-outline-danger">Log out</button>
          </form>
        }
      </div>
    </nav>
  </header>

  <main class="admin-main">
    @RenderBody()
  </main>

  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
