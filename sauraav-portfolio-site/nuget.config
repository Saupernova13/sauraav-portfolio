<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- This project only consumes public packages. Clearing inherited sources keeps restores
       reproducible on CI and on machines with private feeds configured. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
